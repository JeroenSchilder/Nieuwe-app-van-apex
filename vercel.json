        {
            "source": "/performance-scan/start",
            "destination": "/api/performance-scan-start"
        },
        {
            "source": "/performance-scan/voortgang",
            "destination": "/api/performance-scan-progress"
        },
        {
            "source": "/performance-scan/versturen",
            "destination": "/api/performance-scan"
        },
        {
            "source": "/nieuwsbrief/inschrijven",
            "destination": "/api/nieuwsbrief"
        },
        {
            "source": "/gratis-sessie/:id/inschrijven",
            "destination": "/api/gratis-sessie?id=:id"
        }
    ],
    "functions": {
        "api/*.js": {
            "maxDuration": 60
        }
    },
    "headers": [
        {
            "source": "/build/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/images/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ]
}
