{
  "name": "LeerInstelling",
  "type": "object",
  "description": "Instellingen van de leeromgeving (o.a. herinneringen)",
  "properties": {
    "key": {
      "type": "string",
      "description": "Sleutel, bijv. herinneringen"
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Aan"
    },
    "test_mode": {
      "type": "boolean",
      "default": true,
      "description": "Proefmodus: alleen bepalen wie een mail zou krijgen, niets versturen"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Dagen zonder activiteit per herinnering, bijv. [7, 30, 30]"
    },
    "min_progress": {
      "type": "number",
      "description": "Alleen bij voortgang vanaf (%)"
    },
    "max_progress": {
      "type": "number",
      "description": "Alleen bij voortgang tot (%)"
    },
    "subject": {
      "type": "string",
      "description": "Onderwerp van de mail"
    },
    "body": {
      "type": "string",
      "description": "Tekst van de mail. Gebruik {voornaam}, {les}, {leerlijn}, {link}"
    },
    "app_url": {
      "type": "string",
      "description": "Link naar de leeromgeving, bijv. https://app.apexonlinecoaching.nl/leren"
    },
    "event_reminders": {
      "type": "boolean",
      "default": true,
      "description": "Dag van tevoren een herinnering sturen voor agenda-items waarvoor iemand is aangemeld"
    },
    "from_name": {
      "type": "string",
      "description": "Afzendernaam"
    },
    "threshold": {
      "type": "number",
      "description": "Afmeldingen: na hoeveel afmeldingen een melding"
    },
    "period_days": {
      "type": "number",
      "description": "Afmeldingen: binnen hoeveel dagen"
    },
    "late_hours": {
      "type": "number",
      "description": "Afmeldingen: alleen tellen als binnen zoveel uur voor de training (0 = alle afmeldingen)"
    },
    "notify_member": {
      "type": "boolean",
      "default": true,
      "description": "Afmeldingen: lid een bericht sturen"
    },
    "notify_trainer": {
      "type": "boolean",
      "default": true,
      "description": "Afmeldingen: trainer een bericht sturen"
    },
    "trainer_emails": {
      "type": "string",
      "description": "Afmeldingen: e-mailadres(sen) van de trainer, gescheiden door komma's"
    },
    "trainer_phone": {
      "type": "string",
      "description": "Afmeldingen: telefoonnummer van de trainer voor WhatsApp"
    },
    "member_subject": {
      "type": "string",
      "description": "Afmeldingen: onderwerp mail aan lid"
    },
    "member_body": {
      "type": "string",
      "description": "Afmeldingen: tekst aan lid. Gebruik {voornaam}, {aantal}, {dagen}, {training}"
    },
    "trainer_subject": {
      "type": "string",
      "description": "Afmeldingen: onderwerp mail aan trainer"
    },
    "trainer_body": {
      "type": "string",
      "description": "Afmeldingen: tekst aan trainer. Gebruik {naam}, {aantal}, {dagen}, {training}, {datum}, {lijst}"
    },
    "whatsapp_webhook_url": {
      "type": "string",
      "description": "Afmeldingen: webhook voor WhatsApp (bijv. Zapier/Make/Twilio). Ontvangt JSON {to, message, name, type}"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
